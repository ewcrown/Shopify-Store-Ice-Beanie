{{ 'ew-testimonial-slider-section.css' | asset_url | stylesheet_tag }}
{% assign reviews = metaobjects.reviews.values %}
<section class="ice-testimoinal" id="ice-testimoinal">
  <div class="ice-testimoinal-row">
    <div class="ice-testimoinal-col">
      <div class="splide testimonial-slider" data-name="Testimonial Slider">
        <div class="splide__track">
          <div class="splide__list">
            {% for review in reviews %}
              <div class="splide__slide">
                {% render 'ew-testimonial-slider-card',
                  card_image: review.author_image,
                  card_icon: review.icon,
                  card_icon_text: review.icon_text,
                  name:  review.title,
                  paragraph: review.description
                %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "<> Testinomial Slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "presets": [
    {
      "name": "<> Testinomial Slider"
    }
  ],
}
{% endschema %}
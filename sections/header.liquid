<script>
  $(document).ready(function () {
    $('.nav-menu-top-wrapper').click(function () {
      var contentWrapper = $('.nav-menu-content-wrapper:not(.desktop)');

      if (contentWrapper.css('display') == 'none') {
        contentWrapper.css('display', 'flex').hide().slideDown('fast');
      } else {
        contentWrapper.slideUp('fast', function () {
          contentWrapper.css('display', 'none');
        });
      }
    });
  });


  $(document).ready(function() {
    var nav = $('.nav-background');
    var logo = $('.store-logo');
  
    $(window).scroll(function() {
      if ($(window).scrollTop() > 50) { // adjust this value based on when you want the nav to change
        nav.addClass('scrolled');
        logo.addClass('logo-shrink');
      } else {
        nav.removeClass('scrolled');
        logo.removeClass('logo-shrink');
      }
    });
});

</script>


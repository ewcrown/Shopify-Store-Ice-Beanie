{{ 'ew-product.css' | asset_url | stylesheet_tag }}
{% assign s = section.settings %}

<section class="ew-product-section" id="ew-product-section">
  <div class="ew-product-row">
    {% render 'ew-product-satisfactors' %}
    <div class="page-width">
      <div class="ew-product-wrap">
        <div class="ew-product-gallery">
          {% 
            render 'ew-product-gallery-slider'
            product: product,
          %}
          {% 
            render 'ew-product-info',
            product: product,
            s: section.settings
          %}
        </div>
        {% 
          render 'ew-product-details'
          product: product
        %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "<> Product Page",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Reviews Text",
      "default": "1015 Reviews"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "#1 Best Seller"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feel Your Migraine Pain Melt Away"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Lorem Ipsum is simply dummy text of the printing and typesetting has been the industry's"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Relief Now"
    }
  ],
  "blocks": [
    {
      "name": "Satisfactors",
      "type": "satisfactors",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Here"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Here",
          "default": "Fast Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Product Page"
    }
  ],
}
{% endschema %}
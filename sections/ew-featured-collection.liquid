{{ 'ew-featured-collection.css' |  asset_url |  stylesheet_tag }}
{{ 'ew-product-card.css' |  asset_url |  stylesheet_tag }}
{% assign s = section.settings %}
<section class="ew-featured-collection ew-featured-collection-{{ section.id }}" id="ew-featured-collection">
  <div class="ew-featured-collection-row">
    <div class="page-width">
        <div class="ew-featured-collection-wrap">
            {% if s.title != blank %}
            <div class="ew-featured-collection-title-wrap">
                <h3>{{ s.title  }}</h3>
            </div>
            {% else %}
            <div class="ew-featured-collection-title-wrap">
                <h3>{{ s.collection.title }}</h3>
            </div>
            {% endif %}

            <div class="ew-featured-collection-inner-wrap">
            {% for product in section.settings.collection.products %}
                {% 
                    render 'ew-product-card', 
                    card_product: product,
                    border: true
                %}
            {% endfor %}
            </div>
        </div>
    </div>
  </div>
</section>
{%  schema  %}  
{
  "name":"<> Featured Collection",
  "settings": [
    {
      "type": "header",
      "content": "Select Collection"
    },
    {
        "type": "text",
        "id": "title",
        "label": "Collection Title",
        "default": "IceBeanie Bundles"
    },
    {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "<> Featured Collection"
    }
  ]
}
{% endschema %}
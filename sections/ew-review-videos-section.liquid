{{ 'ew-review-videos-section.css' | asset_url | stylesheet_tag }}
{% assign s = section.settings %}
<section class="ice-review-videos" id="ice-review-videos">
  <div class="ice-review-videos-row">
    <div class="ice-review-videos-col">
      <div class="ice-review-video-content page-width">
        <div class="ice-review-video-rating flex align-items-center justify-content-center">
          {% render 'ew-star-icon' %}
          <span>{{ s.rating_text }}</span>
        </div>
        <h3 class="ice-review-video-title">
          <span>
            {% render 'ew-icon-quotes' %}
            {{ s.heading }}
            {% render 'ew-icon-quotes' %}
          </span>
        </h3>
      </div>

      <div class="splide review-sideo-slider" data-name="Review Video Slider">
        <div class="splide__track">
          <div class="splide__list">
            {% for block in section.blocks %}
              <div class="splide__slide">
                <div class="slide-content">
                  <div class="ice-video-container">
                    {{
                      block.settings.video
                      | video_tag:
                        controls: true,
                        playsinline: true,
                        autoplay: false,
                        loop: true,
                        muted: false,
                        image_size: 'master'
                    }}

                    <button class="play-button">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="191"
                        height="191"
                        viewBox="0 0 191 191"
                        fill="none"
                      >
                        <circle opacity="0.3" cx="95.5" cy="95.5" r="95.5" fill="white"/>
                        <circle cx="95.5" cy="95.5" r="56.5" fill="#00A9E7"/>
                        <path d="M114.181 93.294C115.521 94.0518 115.539 95.9762 114.212 96.7579L87.3527 112.587C86.0263 113.369 84.3511 112.422 84.3374 110.882L84.0586 79.7063C84.0449 78.1668 85.7029 77.1897 87.043 77.9475L114.181 93.294Z" fill="#D9D9D9"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "<> Review Videos",
  "settings": [
    {
      "type": "header",
      "content": "Info"
    },
    {
        "type": "text",
        "id": "rating_text",
        "label": "Rating Text Here",
        "default": "4.9 Star Rating"
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Heading Here",
        "default": "About The Founder"
    }
  ],
  "blocks": [
    {
        "type": "video_card",
        "name": "Video Card",
        "settings": [
            {
                "type": "video",
                "id": "video",
                "label": "A Shopify-hosted video"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "<> Review Videos"
    }
  ]
}
{% endschema %}

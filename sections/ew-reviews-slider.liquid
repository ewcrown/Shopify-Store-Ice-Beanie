{{ 'ew-reviews-slider.css' | asset_url | stylesheet_tag }}
{% assign testimonials = metaobjects.testimonials.values %}
{% assign s = section.settings %}
<section class="science-reviews" id="science-reviews">
  <div class="science-reviews-row">
    <div class="page-width">
      <div class="science-reviews-col">
        <div class="review-slider-inner-wrap">
          <div class="splide science-page-reviews flex align-items-center" data-name="Reviews Slider">
            <div class="splide__track">
              <div class="splide__list">
                {% for testimonial in testimonials %}
                <div class="splide__slide">   
                  {% 
                    render 'ew-reviews-slider-card',
                    description: testimonial.description,
                    name: testimonial.author_name,
                    designation: testimonial.designation,
                    image: testimonial.author_image
                  %} 
                </div> 
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{%  schema  %}  
{
  "name":"<> Reviews Slider",
  "settings": [
    
  ],
  "presets": [
    {
      "name": "<> Reviews Slider"
    }
  ]
}
{% endschema %}
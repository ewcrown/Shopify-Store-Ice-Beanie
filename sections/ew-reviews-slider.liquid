{{ 'ew-reviews-slider.css' | asset_url | stylesheet_tag }}
{% assign s = section.settings %}
<section class="science-reviews" id="science-reviews">
  <div class="science-reviews-row">
    <div class="page-width">
      <div class="science-reviews-col">
        <h2 class="review-heading">{{ s.reviews_heading }}</h2>
        <div class="review-slider-inner-wrap">
          <div class="splide science-page-reviews flex align-items-center" data-name="Reviews Slider">
            <div class="splide__track">
              <div class="splide__list">
                {% for block in section.blocks %}
                <div class="splide__slide">   
                  {% 
                    render 'ew-reviews-slider-card',
                    description: block.settings.description,
                    name: block.settings.author_name,
                    designation: block.settings.designation,
                    image: block.settings.author_image
                  %} 
                </div> 
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{%  schema  %}  
{
  "name":"<> Reviews Slider",
  "settings": [
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Heading Here"
    }
  ],
  "blocks": [
    {
      "name": "Card",
      "type": "card",
      "settings": [
        {
          "type": "header",
          "content": "Info"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Description Here",
            "default":"IceBeanie should not only be in every household freezer, but every sports locker room across the country."
        },
        {
            "type": "text",
            "id": "author_name",
            "label": "Author Name",
            "default": "Dr. Erlingsson MD MPH"
        },
        {
            "type": "text",
            "id": "designation",
            "label": "Designation",
            "default": "Harvard Medical"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Reviews Slider"
    }
  ]
}
{% endschema %}
                <div data-w-tab="Tab {{ forloop.index }}" class="tab-pane w-tab-pane {% if forloop.first == true %}w--tab-active{% endif %}">
                  <div class="product-img-wrapper">
                    <div><img src="{{ image | img_url: '1000x' }}" loading="default" data-name="{{ image | name }}" alt="{{image.alt}}" class="large-product-img"></div>
                  </div>
                </div>
              {% endif %}

              {% if media.media_type == 'external_video' or media.media_type == 'video' %}
                <div data-w-tab="Tab {{ forloop.index }}" class="tab-pane w-tab-pane {% if forloop.first == true %}w--tab-active{% endif %}">
                  <div class="product-vid-wrapper">
                    {% comment %}
                    {% if media.media_type == 'external_video' %}
                      <div class="product-vid-wrapper-inner">
                        {{ media | external_video_tag }}
                      </div>
                    {% endif %}
                    {% endcomment %}
                    {% if media.media_type == 'video' and product.tags contains '360 view' %}
                      <div class="product-vid-wrapper-inner">
                        <div style="width: 100%;height: 100%;">
                          <iframe src="https://www.photospherix.com/icebeanie/icebeanie_600/" marginheight="0" marginwidth="0" frameborder="0" scrolling="no" style="display: block; width: 100%; height: 90%;" allowfullscreen="true" mozallowfullscreen="true" webkitallowfullscreen="true" class="pp-embed-content"></iframe>
                          <div class="product-vid-text">
                            Click for 360° motion!
                          </div>
                      </div> 
                      </div>
                    {% endif %}


                    {% if media.media_type == 'video' %}
                      <div class="product-vid-wrapper-inner" style="-webkit-mask-image: -webkit-radial-gradient(white, black); -webkit-backface-visibility: hidden; -moz-backface-visibility: hidden;">
                        {%if media.alt == "360-video"%}
                          {{ media | video_tag: controls: false, playsinline: true, autoplay: true, loop: true, muted: true }}
                          {%else%}
                          {{ media | video_tag: controls: false, playsinline: true, autoplay: true, loop: true, muted: true }}
                          {%- comment -%}
                            {{ media | video_tag: controls: true, autoplay: true, muted: true }}
                          {%- endcomment -%}
                        {%endif%}
                      </div>
                    {% endif %}
                    


                  </div>
                </div>
              {% endif %}

            {% endfor %}


          </div>
          
          {% unless product.id == 7806975410409 %}
            
          <div class="images-tabs-menu w-tab-menu swiper-wrapper">
            {% for media in product.media %}

              {% if media.media_type == 'image' %}
                {% assign image = media %}

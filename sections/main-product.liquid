              {% for product_option in product.options_with_values %}
                <div class="amount-select">
                    <label for="select-{{forloop.index}}" class="product-options-label">{{ product_option.name }}</label>
                    <select id="select-{{forloop.index}}" class="form-text-field ib-{{ product_option.name | downcase }} w-select product-page-select single-option-selector">
                    {% for value in product_option.values %}
                      <option jc-option-id="{{option.id}}" {% if product_option.selected_value == value %}selected{% endif %}>{{value}}</option>
                    {% endfor %}
                    </select>
                </div>
              {% endfor %}
            {% endunless %} 

            <div class="car-btn-and-select-wrapper">
            
                  <select name="id" id="product-select" class="jc-product-select product-form__variants no-js" style="display:none;"
                  data-available-text="{{- 'products.product.add_to_cart' | t -}}"
                  data-solout-text="{{- 'products.product.sold_out' | t -}}"
                  data-unavailable-text="{{- 'products.product.unavailable' | t -}}">
                    {% for variant in product.variants %}
                      {% if variant.available %}
                        <option data-id="{{ variant.featured_media.id }}" data-index="{{ variant.title }}" jc-price="{{variant.price | money}}" {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %} value="{{ variant.id }}">
                          {{ variant.title }}
                        </option>
                      {% else %}
                        <option jc-price="Sold Out" disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
                      {% endif %}
                    {% endfor %}
                  </select>

                <div class="quantity-wrap">
                <a id="quantity-btn-down" href="#" class="w-inline-block">
                  <div class="text-block-9">–</div>
                </a><input type="number" class="w-input" value="1" maxlength="256" name="quantity" data-name="quantity" placeholder="" id="quantity">
                <a id="quantity-btn-up" href="#" class="w-inline-block">
                  <div class="text-block-9">+</div>
                </a>
                </div>
              
              <input type="submit" value="{% if product.type == 'Pre-Order' %}Pre-Order Now{% else %}{{ cart_btn_text }}{% endif %}" data-wait="" class="add-cart-submit-btn w-button" {{ cart_disabled }}>
              </div>

              </form>


              {% endform %}



            </div>
          </div>
        </div>
        <div class="returns-money-back-wrapper">
          <div class="returns-col"><img src="//cdn.shopify.com/s/files/1/0254/3170/3629/files/support-24-7.png?v=1731846691" loading="lazy" alt="" class="returns-img">

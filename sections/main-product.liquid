  <div class="reviews-cool-products-section wf-section">
    <div class="cool-products-container">
      <div class="cool-products-main-heading-wrapper">
        <h1 class="cool-products-main-heading-blue" data-ix="slide-in-bottom-2-delay">Related Products</h1>
      </div>
      <div class="cool-products-content">

        {% assign jc_counter = 0 %}
        {% for product in collections.all-products.products %}

          {% if jc_counter > 2 %}
            {% break %} 
          {% endif %}
          
          {% unless product.id == main_product_id %}

            <div class="cool-products-block product-card" data-ix="slide-in-bottom-2-delay">
              <a href="{{ product.url }}" aria-current="page" class="cool-products-link-block w-inline-block w--current"><img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}" class="cool-products-img">
                <div class="bundle-savings">
                  Save {{ product.compare_at_price | minus: product.price | money -}}
                </div>
                <h3 class="cool-products-heading">{{ product.title }}</h3>
                <div class="shop-links-wrapper">
                    {% if is_available == true %}
                      {% if compare_at_price > price %}
                        <div class="bundle-price">
                          <span style="text-decoration: line-through">{{ compare_at_price | money }}</span>
                          <span id="price">{{ current_variant.price | money }}</span>
                        </div>
                      {% else %}
                        <div class="bundle-price" id="price">
                          {{ current_variant.price | money }}
                        </div>
                      {% endif %}
                    {% else %}
                      <div class="bundle-price">
                        <span id="price" style="text-decoration: line-through;">{{ product.price | money }}</span>
                        Sold Out</div>
                    {% endif %}
                    <div>
                      {% form 'product', product %}
  
                        <select
                          name="id"
                          id="product-select"
                          class="jc-product-select product-form__variants no-js"
                          style="display:none;">
                          {% for variant in product.variants %}
                            {% if variant.available %}
                              <option jc-price="{{variant.price | money}}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}value="{{ variant.id }}">
                                {{ variant.title }}
                              </option>
                            {% else %}
                              <option jc-price="Sold Out" disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
                            {% endif %}
                          {% endfor %}
                        </select>
  
                        <input
                          type="number"
                          class="add-cart-text-field w-input"
                          value="1"
                          maxlength="256"
                          name="quantity"
                          data-name="quantity"
                          placeholder=""
                          id="quantity"
                          style="display:none;">
                        <input
                          type="submit"
                          value="{{ cart_btn_text }}"
                          data-wait=""
                          class="shop-link w-button"
                          {{ cart_disabled }}>
                      {% endform %}
  
                    </div>
                  </div>
                 {% comment %}
                <div class="cool-products-text-wrapper">
                  <div class="smaller-text-block" data-ix="slide-in-bottom-2-delay">{{ product.metafields.product_description.text }}</div>
                </div>
               {% endcomment %}
              </a>
            </div> 

            {% assign jc_counter = jc_counter | plus: 1 %}
          {% endunless %}
               
      {% endfor %}

      </div>
    </div>
  </div>

  {% for media in product.media %}
    {% if media.media_type == 'external_video' %}
      <div class="product-vid-modal-wrapper" sk-modal-vid-id="{{media.id}}">
          <div class="product-vid-modal-content-wrapper">

            <div class="product-vid-modal-inner">
              {{ media | external_video_tag }}
            </div>

              <div class="form-modal-close-btn"><img src="//cdn.shopify.com/s/files/1/0254/3170/3629/files/close-white.png" loading="lazy" alt="Close" class="form-modal-close-btn-img" /></div>
          </div>
      </div>
    {% endif %}
  {% endfor %}

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

  <script type="text/javascript">
    const swiper = new Swiper('.swiper-tabs', {
      slidesPerView: 5,
      spaceBetween: 20,
      breakpoints: {
        320: {
          slidesPerView: 4,
          spaceBetween: 15
        },
        768: {
          slidesPerView: 3
        },
        992: {
          slidesPerView: 5,
          spaceBetween: 20
        }
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });

    const colorElement = document.querySelector('.ib-color');
    const sizeElement = document.querySelector('.ib-size');
    if (sizeElement) {
      const choicesSize = new Choices(sizeElement, {
        searchEnabled: false,
      });
    }
    const choicesColor = new Choices(colorElement, {
      searchEnabled: false,
      callbackOnCreateTemplates: function(strToEl, escapeForTemplate) {
      var classNames = this.config.classNames;
      var itemSelectText = this.config.itemSelectText;
      var allowHTML = this.config.allowHTML;
      return {
        item: function({ classNames }, data) {
          return strToEl(
            '\
        <div\
          class="' +
              String(classNames.item) +
              ' ' +
              String(
                data.highlighted
                  ? classNames.highlightedState
                  : classNames.itemSelectable
              ) +
              '"\
          data-item\
          role="option"\
          data-id="' +
              String(data.id) +
              '"\
          data-value="' +
              String(escapeForTemplate(allowHTML, data.value)) +
              '"\
          ' +
              String(data.active ? 'aria-selected="true"' : '') +
              '\
          ' +
              String(data.disabled ? 'aria-disabled="true"' : '') +
              '\
          >\
          <span class="' + data.label.toLowerCase() + ' circle-color" style="margin-right:10px;"></span> ' +
              String(escapeForTemplate(allowHTML, data.label)) +
              '\
        </div>\
      '
          );
        },
        choice: function({ classNames }, data) {
          return strToEl(
            '\
        <div\
          class="' +
              String(classNames.item) +
              ' ' +
              String(classNames.itemChoice) +
              ' ' +
              String(
                data.disabled
                  ? classNames.itemDisabled
                  : classNames.itemSelectable
              ) +
              '"\
          data-select-text="' +
              String(itemSelectText) +
              '"\
          data-choice \
          ' +
              String(
                data.disabled
                  ? 'data-choice-disabled aria-disabled="true"'
                  : 'data-choice-selectable'
              ) +
              '\
          data-id="' +
              String(data.id) +
              '"\
          data-value="' +
              String(escapeForTemplate(allowHTML, data.value)) +
              '"\
          ' +
              String(
                data.groupId > 0 ? 'role="treeitem"' : 'role="option"'
              ) +
              '\
          >\
          <span class="' + data.label.toLowerCase() + ' circle-color" style="margin-right:10px;"></span> ' +
              String(escapeForTemplate(allowHTML, data.label)) +
              '\
        </div>\
      '
          );
        },
      };
    },
    });

    $(document).ready(function(){

        $('.product-tab-link-video').click(function(e) {
          e.preventDefault();
          $('body').css('overflow', 'hidden');
          var vid_id = $(this).attr('sk-vid-id');
          var id_string = '.product-vid-modal-wrapper[sk-modal-vid-id="'+ vid_id +'"';
          var current_modal = $(id_string);
          current_modal.css('display','block');
          current_modal.fadeTo(500,1);
      });

        $('.form-modal-close-btn').click(function(e) {
            e.preventDefault();
            $('body').css('overflow', 'auto');

            $('.product-vid-modal-wrapper').each(function(i, obj) {
                    $(this).fadeTo(500,0,function(){
                     $(this).hide();
                });
            });

        });


    });
    
  </script>

<script>
   
   $(document).ready(function() { 
       

      $("#quantity-btn-down").click(function(){
       
        $('#quantity').val( function(i, oldval) {
            if (oldval < 2) {
              return 1;
            } else {
              return --oldval;
            }
        });
      });
      $("#quantity-btn-up").click(function(){
        
        $('#quantity').val( function(i, oldval) {
            return ++oldval;
        });

      });

    });





   

   </script>

   




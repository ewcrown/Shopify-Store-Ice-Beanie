                  <div class="tab-link-img-wrapper-product tab-link-img-wrapper-product-vid">
                    <div class="tab-link-vid-overlay"><img src="//cdn.shopify.com/s/files/1/0254/3170/3629/files/play-sk-update.png" class="tab-link-vid-overlay-img"></div>
                    {% if media.alt == "demo-video" %}
                      <img src="https://cdn.shopify.com/s/files/1/0254/3170/3629/files/Screenshot_2023-08-29_at_4.09.28_PM.png?v=1693347225" loading="lazy" alt="{{product.title}}" class="tab-link-img-product tab-link-img-product-vid">
                      {%elsif media.alt == "360-video"%}
                      <img src="https://cdn.shopify.com/s/files/1/0254/3170/3629/files/Icebeanie-thumbnail-rotate.png?v=1693349155" loading="lazy" alt="{{product.title}}" class="tab-link-img-product tab-link-img-product-vid">
                      {%else%}
                      <img src="{{ media.preview_image | img_url: '256x256' }}" loading="lazy" alt="{{product.title}}" class="tab-link-img-product tab-link-img-product-vid">
                    {% endif %}
                  </div>
                </a>
              {% endif %}

              {% if media.media_type == 'external_video' %}
                <a data-w-tab="Tab {{ forloop.index }}" class="swiper-slide {%if product.id == 8095938576617 %} ice-2_0 {% endif %} w-inline-block product-tab-link-video w-tab-link {% if forloop.first == true %}w--current{% endif %}" jc-variant-id="#" sk-vid-id="{{media.id}}" data-id="{{ media.id }}">
                  <div class="tab-link-img-wrapper-product tab-link-img-wrapper-product-vid">
                    
                    <img src="{{ media.preview_image | img_url: '256x256' }}" loading="lazy" alt="{{product.title}}" class="tab-link-img-product tab-link-img-product-vid">
                  </div>

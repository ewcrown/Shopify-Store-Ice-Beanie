{% schema %}
{
  "name": "Video Reviews",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "top_quote",
      "label": "Top Quote"
    },
    {
      "type": "text",
      "id": "top_name",
      "label": "Top Name"
    },
    {
      "type": "text",
      "id": "top_title",
      "label": "Top Title"
    },
    {
      "type": "text",
      "id": "main_heading",
      "default": "Additional Video Reviews",
      "label": "Section Heading"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Reviews",
      "settings": [
        {
          "label": "Thumbnail Image",
          "id": "thumbnail_image",
          "type": "image_picker"
        },
        {
          "type": "text",
          "id": "vid_id",
          "label": "YouTube Vid ID"
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'ew-icon-text-section.css' | asset_url | stylesheet_tag }}
{% assign s = section.settings %}
<section class="ice-shipping" id="ice-shipping">
  <div class="ice-shipping-row">
      <div class="page-width">
          <div class="ice-shipping-col">
              {% for block in section.blocks %}
              <div class="ice-shipping-wrap align-items-center">
                <img 
                  class="ew-img-fluid"
                  src="{{ block.settings.image | image_url: width: 100 }}" 
                  alt="{{ block.settings.title }}">
                  <span>{{  block.settings.title }}</span>
              </div>
              {% endfor %}
          </div>
      </div>
  </div>
</section>
{% schema %}
{
  "name": "<> Icon Text Section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "icon-text",
      "name": "Icon Text Info",
      "limit": 4,
      "settings": [
        {
          "type": "header",
          "content": "Icon Text Info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Metabolic System"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Icon Text Section"
    }
  ],
}
{% endschema %}
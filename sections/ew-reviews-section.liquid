{{ 'ew-reviews-section.css' | asset_url | stylesheet_tag }}
{% assign s = section.settings %}
<section class="ice-reviews" id="ice-reviews">
  <div class="ice-reviews-row">
      <div class="page-width">
          <div class="ice-reviews-col">
              <div class="ice-reviews-heading-img justify-content-between">
                  <h2>{{ s.heading }}</h2>
                  <div class="ice-reviews-content flex align-items-center">
                      {% render 'ew-star-icon' %}
                      <span>{{ s.reviews_text }}</span>
                  </div>
              </div>
              <div class="ice-reviews-desc-btn justify-content-between">
                  <p>
                      {{ s.description }}
                  </p>
                  {% if s.button_link != blank %}
                    <a href="{{ s.button_link }}" class="primary-btn">{{ s.button_text }}</a>
                  {% endif %}
              </div>
          </div>
      </div>
  </div>
</section>
{% schema %}
{
  "name": "<> Reviews Section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Reviews From Real Customers"
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Reviews Text",
      "default": "5 / 5 1,438 Reviews"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Lorem Ipsum is simply dummy text of the printing and typesetting has been the industry's"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "5-star review"
    }
  ],
  "presets": [
    {
      "name": "<> Reviews Section"
    }
  ],
}
{% endschema %}
<div class="ew-product-content-inner">
  
  <div class="ew-product-content-review">
    {% render 'ew-star-icon' %}
    <span>1015 Reviews</span>
  </div>
  
  <h3 class="ew-product-content-title">
    {{  first_product.title }}
  </h3>

  <div class="ew-product-content-tags">
    <ul>
        <li>
          #1 Best Seller
        </li>
    </ul>
  </div>

  <div class="ew-product-content-price">
    {% render 'price', product: first_product %}
  </div>

  <div class="ew-product-content-description">
    {{ first_product.description | truncate: 250 | strip_html }}
  </div>

    <div class="ew-product-content-radios">
      {% for product in products %}
      <div class="ew-product-content-radio-single">
        <input type="radio" id="ice-{{ product.id }}" data-index="{{ forloop.index }}" name="product" value="{{ product.title }}" {% if forloop.index == 1 %}checked{% endif %} data-url="{{ product.url }}">
        <label for="ice-{{ product.id }}">
          <span class="ew-product-radio-title">{{ product.title }}</span>
          <span class="ew-product-radio-price">
            {% render 'price', product: product %}
          </span>
        </label>
    </div>
    {% endfor %}

    </div>

    <div class="ew-product-content-color-radios">
        <label>
          Select Beanie Color:
        </label>

        <div class="ew-product-content-color-radio">    
        
        {% for variant in first_product.variants %}
          <div class="ew-product-content-color-radio-single ew-product-content-color-radio-single-{{ variant.title | handleize }}">    
            <input type="radio" data-variant="{{ variant.id }}" id="{{variant.title | handleize}}-{{ variant.id }}" name="color" value="{{ variant.title  }}" {% if forloop.index == 1 %}checked{% endif %}>
            <label for="{{ variant.title | handleize}}-{{ variant.id }}">{{ variant.title  }}</label>
          </div>
        {% endfor %}
          
        </div>
    </div>
    <button class="primary-btn" data-id="{{ first_product.selected_or_first_available_variant.id }}" data-featured-add-to-cart>Add To Cart</button>
</div>
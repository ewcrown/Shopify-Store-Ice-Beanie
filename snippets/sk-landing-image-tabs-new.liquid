<script>
  window.onload = function () {
    var thumbnails = document.getElementsByClassName('s-product-thumbnail-image');
    for (var i = 0; i < thumbnails.length; i++) {
      thumbnails[i].addEventListener('click', function (e) {
        var largeImages = document.getElementsByClassName('s-product-image-large');
        for (var j = 0; j < largeImages.length; j++) {
          largeImages[j].style.display = 'none'; // Hide all large images
          largeImages[j].style.opacity = 0.5; // Reset the opacity of all large images
        }
        var largeImageId = this.getAttribute('data-large-image-id');
        var selectedImage = document.getElementById(largeImageId);
        selectedImage.style.display = 'block'; // Show the selected large image
        selectedImage.style.opacity = 1; // Set the opacity of the selected image to 1
      });
    }
  };
</script>

<style>
  .s-product-image-large {
    display: none;
    opacity: 0.5; /* you can adjust this value according to your needs */
  }

  .s-product-image-large:first-of-type {
    display: block;
    opacity: 1;
  }
</style>
